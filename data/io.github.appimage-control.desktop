[Desktop Entry]
Type=Application
Name=AppImage Control
Comment=Install and manage AppImage applications
Exec=appimage-control
Icon=io.github.appimagecontrol.AppImageControl
Terminal=false
Categories=Utility;PackageManager;
StartupNotify=true
StartupWMClass=io.github.appimagecontrol.AppImageControl
X-Flatpak-RenamedFrom=io.github.appimage-control.desktop;
