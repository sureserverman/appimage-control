msgid ""
"Search order:\n"
"  1. APPIMAGE_CONTROL_CATALOG environment variable\n"
"  2. data/catalog.json above a dev build (cargo target/ dir only)\n"
"  3. /app/share/, /usr/share/appimage-control/catalog.json\n"
"  4. catalog compiled into this build"
msgstr ""
"Orden de búsqueda:\n"
"  1. Variable de entorno APPIMAGE_CONTROL_CATALOG\n"
"  2. data/catalog.json encima de una compilación de desarrollo (solo carpeta "
"target/ de cargo)\n"
"  3. /app/share/, /usr/share/appimage-control/catalog.json\n"
"  4. Catálogo integrado en esta compilación"

