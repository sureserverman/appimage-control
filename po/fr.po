#: crates/gui/src/main.rs:507
msgid ""
"AppImage Control couldn’t find an application catalog. Open one, or set "
"APPIMAGE_CONTROL_CATALOG to a catalog file."
msgstr ""
"AppImage Control n’a trouvé aucun catalogue d’applications. Ouvrez-en un ou "
"définissez APPIMAGE_CONTROL_CATALOG sur un fichier de catalogue."

#: crates/gui/src/main.rs:520
msgid ""
"Search order:\n"
"  1. APPIMAGE_CONTROL_CATALOG environment variable\n"
"  2. data/catalog.json above a dev build (cargo target/ dir only)\n"
"  3. /app/share/, /usr/share/appimage-control/catalog.json\n"
"  4. catalog compiled into this build"
msgstr ""
"Ordre de recherche :\n"
"  1. variable d’environnement APPIMAGE_CONTROL_CATALOG\n"
"  2. data/catalog.json au-dessus d’une version de développement (dossier "
"cargo target/ uniquement)\n"
"  3. /app/share/, /usr/share/appimage-control/catalog.json\n"
"  4. catalogue compilé dans cette version"

